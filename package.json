{
  "name": "onemark",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "spec": "pnpm --filter @onemark/fidelity spec",
    "bench": "pnpm --filter @onemark/bench bench",
    "build:wasm": "./scripts/build-wasm.sh",
    "determinism": "cargo run -q -p onemark-engine --example dump_corpus -- fidelity/corpus /tmp/native-dump && pnpm exec tsx scripts/corpus-determinism.mjs /tmp/native-dump fidelity/corpus"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
