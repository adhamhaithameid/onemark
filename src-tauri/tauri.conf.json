{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneMark",
  "version": "0.1.0",
  "identifier": "com.adhamhaithameid.onemark",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "OneMark",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'none'; connect-src 'self'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
